# Where the catalog backend is, as seen from the device running this app.
#
# `localhost` here would mean the phone itself, not the machine running the
# server, so it is never the right answer on Android.
#
#   Physical device    http://<machine-LAN-IP>:<port>   <-- in use below
#   Android emulator   http://10.0.2.2:<port>           (10.0.2.2 = the host)
#   iOS simulator      http://localhost:<port>          (shares the host network)
#
# 10.0.2.2 exists only inside the emulator. From a real phone it routes nowhere,
# and because an unroutable address is dropped rather than refused, every request
# hangs instead of failing — which shows up as a form stuck on "Loading...".
#
# The port is the backend's PORT; internal-backend defaults to 8080.
#
# Expo reads this at bundle time, so restart `expo start` after changing it.
EXPO_PUBLIC_API_URL=http://192.168.100.201:8080
